 "limitations": [
  {
   "wanted": "Measure the old wheel's tread profile, the door's track, the M8 bolt's length and the bracket's thickness",
   "blocked_by": "The person could not measure those items (\"I can't measure that\"), and there is no tool to inspect a physical part remotely",
   "why": "The tread shape (flat vs grooved) and the axle length decide whether the new wheel rides the track correctly and whether the existing bolt is long enough - so I had to design a tread that tolerates both cases and specify a catalog bolt as a fallback"
  },
  {
   "wanted": "Use the catalog ISO 7089 M8 steel washers under the bolt head and lock nut",
   "blocked_by": "Their 16 mm outside diameter is larger than a 608's inner ring (~12 mm) and would press on the bearing's rotating shield",
   "why": "Steel washers are the normal way to spread a nut's load - instead I had to add two printed 1 mm thrust rings (OD 11 mm) that contact only the inner ring, which adds two small prints to the job"
  },
  {
   "wanted": "Verify the bearing's internal dimensions (inner ring OD, shield OD, width) rather than assume them",
   "blocked_by": "608 datasheets give only 8/22/7; the shield and inner-ring diameters that set my 18.4 mm relief hole and 11 mm spacer/ring OD are not published in the hardware list, and the person could not measure them",
   "why": "Those two diameters decide whether the printed web rubs the rotating shield or the stationary inner ring - a wrong guess means the wheel drags or squeals"
  }
 ],
