ance around measured head.\"},\"head_pocket_depth_mm\":{\"value\":4.6,\"kind\":\"design\",\"source\":\"design\",\"note\":\"Leaves the head about 0.4 mm proud for gripping from below.\"}},\"parts\":[{\"id\":\"camera_plate\",\"role\":\"final\",\"material\":\"PLA, high-speed PLA\",\"code\":\"def build(p):\\n    bw = p.plate_bottom_width_mm\\n    tw = p.plate_top_width_mm\\n    z0 = p.lower_straight_height_mm\\n    z1 = z0 + p.dovetail_height_mm\\n    h = p.plate_thickness_mm\\n    pts = [(-bw/2, 0), (bw/2, 0), (bw/2, z0), (tw/2, z1), (tw/2, h), (-tw/2, h), (-tw/2, z1), (-bw/2, z0)]\\n    body = cq.Workplane('XZ').polyline(pts).close().extrude(p.plate_length_mm).translate((0, p.plate_length_mm/2, 0))\\n    through = cq.Workplane('XY').workplane(offset=-0.1).circle(p.bolt_clearance_hole_diameter_mm/2).extrude(h + 0.2)\\n    pocket = cq.Workplane('XY').workplane(offset=-0.1).circle(p.head_pocket_diameter_mm/2).extrude(p.head_pocket_depth_mm + 0.1)\\n    return body.cut(through).cut(pocket)\",\"print_orientation\":\"Narrow flat foot (z=0) on the bed; camera-contact face at z=8 mm.\",\"use_orientation\":\"Dovetail edges run along the clamp jaws; the metal 1/4-20 bolt passes upward through the centered hole into the camera socket.\"}],\"hardware\":[{\"id\":\"camera_bolt\",\"ref\":\"salvaged:webcam-mount-bolt\",\"qty\":1}],\"joints\":[{\"id\":\"camera_attachment\",\"fastener\":\"camera_bolt\",\"axis_origin\":[0,0,4.6],\"axis_dir\":[0,0,1],\"seats\":[{\"part\":\"camera_plate\",\"feature\":\"underside counterbore ceiling (head bearing face at z=4.6 mm)\",\"role\":\"head_seat\"},{\"part\":\"camera_plate\",\"feature\":\"centered 6.8 mm through-hole\",\"role\":\"clearance\"}],\"external\":\"Camera's 1/4-20 socket\"}],\"criteria\":[{\"id\":\"clamp_fit\",\"part\":\"camera_plate\",\"feature\":\"dovetail side faces and overall width\",\"relation\":\"clears\",\"clearance_mm\":0,\"params\":[\"plate_top_width_mm\",\"plate_bottom_width_mm\",\"plate_thickness_mm\",\"dovetail_height_mm\"],\