 "limitations": [
  {
   "wanted": "a precision 8 mm shoulder bolt / ground axle shaft for the 608 bearings to ride on",
   "blocked_by": "the hardware list has only threaded screws (ISO 4762) \u2014 no shoulder screws, shafts or bushings",
   "why": "a 608 bore is 8.00 mm nominal; an M8 thread also measures 8 mm \"across the shank\" but is only ~7.8-7.98 mm over the crests, so the far bearing's inner ring rides on thread crests instead of a true bearing seat"
  },
  {
   "wanted": "a shoulder washer / \"speed ring\" (a small-OD washer that presses only the bearing's inner ring)",
   "blocked_by": "only plain ISO 7089 washers are in the list, and an M8 washer is 16 mm OD \u2014 wider than the 608 inner ring (~11.9 mm), so it would rub the bearing's rotating shield",
   "why": "it's exactly what keeps the clamping load off the seals; since none exists, I had to print 11.4 mm-OD spacer rings as part of the design"
  },
  {
   "wanted": "retaining compound (Loctite-style) or a drop of adhesive to keep the bearing outer rings in the printed pockets",
   "blocked_by": "not in the hardware list",
   "why": "if the printed pocket comes out a little loose, the outer ring can creep/rotate in the plastic; with glue the press fit would be less critical (as it is, the fit coupon has to do that job)"
  },
  {
   "wanted": "a tougher tread material (PETG, nylon or a TPU tyre) for a wheel that rolls under a loaded door in a metal track",
   "blocked_by": "the printer/filament supplied is PLA only",
   "why": "PLA creeps and wears in a sliding track; a wheel that carries a door's weight is exactly the case where PETG or nylon would last much longer"
  },
  {
   "wanted": "the salvaged 1/4\"-20 webcam-mount bolt as the axle",
   "blocked_by": "1/4-20 is \u00d86.35 mm against a \u00d88 mm bearing bore, and no sleeve/bushing is in the hardware list",
   "why": "it's the one salvaged fastener on hand, and worth ruling out explicitly rather than leaving it as \"maybe\""
  }
